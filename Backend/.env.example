DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Profile_db

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

CORS_ORIGINS=http://localhost:5173

UPLOAD_DIR=uploads
MAX_IMAGE_MB=8
MAX_RESUME_MB=10

# Accounts
ALLOW_SIGNUP=true
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_MINUTES=60

# Email for password reset. Leave SMTP_HOST empty in development:
# the reset link is then printed in the backend terminal instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Keep uploads on Cloudinary instead of the local uploads folder (needed on hosts that wipe their disk).
# The line from the Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
